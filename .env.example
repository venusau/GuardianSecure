# ---- Application ----
SECRET_KEY=change-me-to-a-long-random-string
APP_PUBLIC_URL=http://localhost:5500
DATABASE_URI=postgresql://guardian:guardian@postgres:5432/guardian
ADMIN_EMAIL=admin@guardiansecure.app

# ---- Mail (OTP + scan reports) ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
DEFAULT_SENDER=GuardianSecure <no-reply@guardiansecure.app>
MAIL_USE_TLS=False
MAIL_USE_SSL=True

# ---- Redis (sessions cache, rate limiting, scan status) ----
REDIS_URL=redis://redis:6379/0

# ---- Kafka (scan pipeline) ----
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP=kafka:9092

# ---- Temporal (scan orchestration) ----
USE_TEMPORAL=false
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_TASK_QUEUE=guardian-scan-queue

# ---- API rate limiting ----
API_RATE_LIMIT=20
API_RATE_WINDOW=60

# ---- Scanner tuning ----
SCANNER_MAX_PAGES=50
SCANNER_TIMEOUT=10
